· cat > durations/__init__.py <<'EOF' """Parse durations such as "90s", "15m", "1h30m", "PT1H30M" or "P2DT4H" into seconds. ISO 8601 durations start with "P" and their parts must be in order; years count as 365 days and months as 30 days. """ import re _UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400} _PART = re.compile(r"(\d+)([smhd])") _VALID = re.compile(r"(\d+[smhd])+") _ISO = re.compile( r"p" r"(?:(?P<weeks>\d+)w" r"|(?:(?P<years>\d+)y)?(?:(?P<months>\d+)m)?(?:(?P<days>\d+)d)?" r"(?:t(?=\d)(?:(?P<hours>\d+)h)?(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?)?)" ) _ISO_SECONDS = { "weeks": 7 * 86400, "years": 365 * 86400, "months": 30 * 86400, "days": 86400, "hours": 3600, "minutes": 60, "seconds": 1, } def _parse_iso(text: str) -> int: """Return the number of seconds in an ISO 8601 duration like "P2DT4H".""" match = _ISO.fullmatch(text) if match is None or not any(match.groups()): raise ValueError(f"not a duration: {text!r}") total = 0 for name, seconds in _ISO_SECONDS.items(): value = match.group(name) if value is not None: total += int(value) * seconds return total def parse_duration(text: str) -> int: """Return the number of seconds in a duration string like "1h30m" or "P2DT4H".""" text = text.strip().lower() if not text: raise ValueError("empty duration") if text.startswith("p"): return _parse_iso(text) if not _VALID.fullmatch(text): raise ValueError(f"not a duration: {text!r}") parts = _PART.findall(text) if not parts: raise ValueError(f"not a duration: {text!r}") total = 0 for value, unit in parts: total += int(value) * _UNITS[unit] return total EOF
· cat > tests/test_durations.py <<'EOF' import unittest from durations import parse_duration class ParseDurationTest(unittest.TestCase): def test_seconds(self): self.assertEqual(parse_duration("90s"), 90) def test_minutes(self): self.assertEqual(parse_duration("15m"), 900) def test_hours(self): self.assertEqual(parse_duration("2h"), 7200) def test_combined_hours_minutes(self): self.assertEqual(parse_duration("1h30m"), 5400) def test_combined_hours_minutes_seconds(self): self.assertEqual(parse_duration("2h15m30s"), 8130) def test_empty(self): with self.assertRaises(ValueError): parse_duration(" ") def test_days(self): self.assertEqual(parse_duration("7d"), 604800) def test_combined_days_hours(self): self.assertEqual(parse_duration("1d12h"), 129600) def test_unknown_unit_is_rejected(self): with self.assertRaises(ValueError): parse_duration("1h30x") def test_completely_invalid_text(self): with self.assertRaises(ValueError): parse_duration("abc") def test_iso_hours_minutes(self): self.assertEqual(parse_duration("PT1H30M"), 5400) def test_iso_days_hours(self): self.assertEqual(parse_duration("P2DT4H"), 187200) def test_iso_days(self): self.assertEqual(parse_duration("P3D"), 259200) def test_iso_hours_minutes_seconds(self): self.assertEqual(parse_duration("PT2H15M30S"), 8130) def test_iso_days_hours_minutes_seconds(self): self.assertEqual(parse_duration("P1DT2H15M30S"), 95730) def test_iso_weeks(self): self.assertEqual(parse_duration("P2W"), 1209600) def test_iso_seconds(self): self.assertEqual(parse_duration("PT45S"), 45) def test_iso_lowercase(self): self.assertEqual(parse_duration("p2dt4h"), 187200) def test_iso_surrounding_spaces(self): self.assertEqual(parse_duration(" PT1M "), 60) def test_iso_month_is_not_a_minute(self): self.assertEqual(parse_duration("P1M"), 30 * 86400) self.assertEqual(parse_duration("PT1M"), 60) def test_iso_years_months_days(self): self.assertEqual(parse_duration("P1Y1M1D"), (365 + 30 + 1) * 86400) def test_iso_zero(self): self.assertEqual(parse_duration("PT0S"), 0) def test_iso_empty_duration_is_rejected(self): with self.assertRaises(ValueError): parse_duration("P") def test_iso_time_designator_alone_is_rejected(self): with self.assertRaises(ValueError): parse_duration("PT") def test_iso_trailing_time_designator_is_rejected(self): with self.assertRaises(ValueError): parse_duration("P1DT") def test_iso_out_of_order_components_are_rejected(self): with self.assertRaises(ValueError): parse_duration("PT30M1H") def test_iso_repeated_components_are_rejected(self): with self.assertRaises(ValueError): parse_duration("PT1H1H") def test_iso_weeks_combined_with_other_components_are_rejected(self): with self.assertRaises(ValueError): parse_duration("P1W2D") def test_iso_fractional_seconds_are_rejected(self): with self.assertRaises(ValueError): parse_duration("PT0.5S") def test_iso_unknown_components_are_rejected(self): with self.assertRaises(ValueError): parse_duration("P1D2X") def test_loose_parts_cannot_follow_an_iso_duration(self): with self.assertRaises(ValueError): parse_duration("P1D30m") if __name__ == "__main__": unittest.main() EOF cd repo && python3 -m unittest -q
