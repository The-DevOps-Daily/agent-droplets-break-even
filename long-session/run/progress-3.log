· cat > tests/test_cli.py <<'EOF' import subprocess import sys import unittest from contextlib import redirect_stderr, redirect_stdout from io import StringIO from pathlib import Path from durations.__main__ import main REPO_ROOT = Path(__file__).resolve().parents[1] class CommandLineTest(unittest.TestCase): def test_main_prints_seconds(self): out = StringIO() with redirect_stdout(out): self.assertEqual(main(["1h30m"]), 0) self.assertEqual(out.getvalue(), "5400\n") def test_main_prints_each_duration_on_its_own_line(self): out = StringIO() with redirect_stdout(out): self.assertEqual(main(["90s", "P2DT4H"]), 0) self.assertEqual(out.getvalue(), "90\n187200\n") def test_main_without_arguments(self): out = StringIO() err = StringIO() with redirect_stdout(out), redirect_stderr(err): self.assertEqual(main([]), 2) self.assertEqual(out.getvalue(), "") self.assertIn("usage", err.getvalue()) def test_main_rejects_invalid_duration(self): out = StringIO() err = StringIO() with redirect_stdout(out), redirect_stderr(err): self.assertEqual(main(["abc"]), 2) self.assertEqual(out.getvalue(), "") self.assertIn("not a duration", err.getvalue()) def test_main_prints_nothing_when_any_duration_is_invalid(self): out = StringIO() err = StringIO() with redirect_stdout(out), redirect_stderr(err): self.assertEqual(main(["90s", "abc"]), 2) self.assertEqual(out.getvalue(), "") self.assertIn("not a duration", err.getvalue()) def test_module_entry_point(self): result = subprocess.run( [sys.executable, "-m", "durations", "1h30m"], capture_output=True, text=True, cwd=REPO_ROOT, ) self.assertEqual(result.returncode, 0) self.assertEqual(result.stdout, "5400\n") self.assertEqual(result.stderr, "") def test_module_entry_point_rejects_invalid_duration(self): result = subprocess.run( [sys.executable, "-m", "durations", "1h30x"], capture_output=True, text=True, cwd=REPO_ROOT, ) self.assertEqual(result.returncode, 2) self.assertIn("not a duration", result.stderr) if __name__ == "__main__": unittest.main() EOF
