unit 'h' is out of order at position 7 in 'pt30m1h'", ) def test_iso_combined_weeks_are_called_out(self): with self.assertRaises(ValueError) as raised: parse_duration("P1W2D") self.assertEqual( str(raised.exception), "weeks cannot be combined with other components in 'p1w2d'", ) ''' tests.write_text(text.replace(guard, new_class.rstrip("\n") + "\n\n\n" + guard, 1)) readme = Path("README.md") text = readme.read_text() old = "own line, and input that cannot be parsed exits with status 2." new = "own line. Input that cannot be parsed exits with status 2, and so does\ncalling it with no arguments." assert text.count(old) == 1 readme.write_text(text.replace(old, new, 1)) PYEOF python3 -m unittest -q && python3 - <<'EOF' from durations import parse_duration for text in ["P", "PT", "P1DT", "abc", "1h30x", "90", "P1W2D", "PT30M1H", "PT1H1H", "PT0.5S", "P1D2X", "P1D30m", "P1M1Y", "P90", "1h3", "P-1D", "9 0s"]: try: parse_duration(text) print("accepted", text) except ValueError as error: print(f"{text!r:12} -> {error}") print(parse_duration("P1Y1M1DT1H1M1S"), parse_duration("P1YT1H"), parse_duration("PT1H30M")) EOF git status --short && git diff --stat
