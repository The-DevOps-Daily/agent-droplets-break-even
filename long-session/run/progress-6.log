· cat > durations/__init__.py <<'EOF' """Parse durations such as "90s", "15m", "1h30m", "PT1H30M" or "P2DT4H" into seconds. ISO 8601 durations start with "P" and their parts must be in order; years count as 365 days and months as 30 days. """ import re _UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400} _PART = re.compile(r"(\d+)([smhd])") _DIGITS = re.compile(r"\d*") _WEEKS = re.compile(r"(\d+)w") _ISO_DATE_PARTS = ( (re.compile(r"(\d+)y"), 365 * 86400), (re.compile(r"(\d+)m"), 30 * 86400), (re.compile(r"(\d+)d"), 86400), ) _ISO_TIME_PARTS = ( (re.compile(r"(\d+)h"), 3600), (re.compile(r"(\d+)m"), 60), (re.compile(r"(\d+)s"), 1), ) _ISO_UNITS = "ymdhstw" def _unparsed_error(text: str, position: int, units: str) -> ValueError: """Return the error explaining what at `position` keeps `text` from parsing.""" digits = _DIGITS.match(text, position).group() if digits: unit_position = position + len(digits) if unit_position == len(text): return ValueError( f"missing unit after {digits!r} at position {position + 1} in {text!r}" ) unit = text[unit_position] if unit in units: return ValueError( f"unit {unit!r} is out of order at position {unit_position + 1} in {text!r}" ) return ValueError( f"unknown unit {unit!r} at position {unit_position + 1} in {text!r}" ) return ValueError( f"expected a number, found {text[position]!r} at position {position + 1} in {text!r}" ) def _parse_iso(text: str) -> int: """Return the number of seconds in an ISO 8601 duration like "P2DT4H".""" weeks = _WEEKS.fullmatch(text[1:]) if weeks is not None: return int(weeks.group(1)) * 7 * 86400 if _WEEKS.match(text[1:]) is not None: raise ValueError(f"weeks cannot be combined with other components in {text!r}") total = 0 position = 1 seen = False for part, seconds in _ISO_DATE_PARTS: match = part.match(text, position) if match is not None: total += int(match.group(1)) * seconds seen = True position = match.end() if position < len(text) and text[position] == "t": position += 1 time_seen = False for part, seconds in _ISO_TIME_PARTS: match = part.match(text, position) if match is not None: total += int(match.group(1)) * seconds seen = True time_seen = True position = match.end() if position == len(text) and not time_seen: raise ValueError(f"missing components after 't' in {text!r}") if position < len(text): raise _unparsed_error(text, position, _ISO_UNITS) if not seen: raise ValueError(f"missing components after 'p' in {text!r}") return total def parse_duration(text: str) -> int: """Return the number of seconds in a duration string like "1h30m" or "P2DT4H".""" text = text.strip().lower() if not text: raise ValueError("empty duration") if text.startswith("p"): return _parse_iso(text) total = 0 position = 0 while position < len(text): match = _PART.match(text, position) if match is None: raise _unparsed_error(text, position, "smhd") total += int(match.group(1)) * _UNITS[match.group(2)] position = match.end() return total EOF
